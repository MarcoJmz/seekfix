{
  "name": "seekfix",
  "private": true,
  "description": "SeekFix – Broken Link Checker & Fixer",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "composer": "wp-env run tests-cli --env-cwd=wp-content/plugins/seekfix composer",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/seekfix vendor/bin/phpunit",
    "test:php:multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/seekfix env WP_MULTISITE=1 vendor/bin/phpunit",
    "lint:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/seekfix vendor/bin/phpcs"
  },
  "devDependencies": {
    "@wordpress/env": "^12.2.0"
  }
}
