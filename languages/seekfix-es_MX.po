#: src/PostWriter.php:34
msgid "You are not allowed to edit this post."
msgstr "No tienes permiso para editar esta entrada."

#. translators: %s: name of the user who is editing the post.
#: src/PostWriter.php:62
msgid "%s is editing this post right now. Try again when they are done."
msgstr "%s está editando esta entrada en este momento. Inténtalo de nuevo cuando termine."

#: src/PostWriter.php:63
msgid "Another user"
msgstr "Otro usuario"

#: src/PostWriter.php:124
msgid "Saving this post would change more than the link, because a plugin filters post content on save. Open the editor to fix it."
msgstr "Guardar esta entrada cambiaría algo más que el enlace, porque un plugin filtra el contenido al guardar. Abre el editor para corregirlo."

#: src/PostWriter.php:125
msgid "Saving this post with your role would remove HTML that only administrators can add. Ask an administrator to fix it, or open the editor."
msgstr "Guardar esta entrada con tu perfil quitaría HTML que solo los administradores pueden agregar. Pide a un administrador que lo corrija o abre el editor."

#. translators: %s: error message from WordPress.
#: src/PostWriter.php:144
