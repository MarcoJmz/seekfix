#. Plugin Name of the plugin
#: seekfix.php
msgid "SeekFix – Broken Link Checker & Fixer"
msgstr "SeekFix – Revisa y corrige enlaces rotos"

#. Plugin URI of the plugin
#: seekfix.php
msgid "https://github.com/MarcoJmz/seekfix"
msgstr "https://github.com/MarcoJmz/seekfix"

#. Description of the plugin
#: seekfix.php
msgid "Finds and fixes broken links without leaving WordPress. Every fix can be undone."
msgstr "Encuentra y corrige enlaces rotos sin salir de WordPress. Cada corrección se puede deshacer."

#. Author of the plugin
#: seekfix.php
msgid "MarcoJmz"
msgstr "MarcoJmz"

#. Author URI of the plugin
