#. translators: %s: time since the scan started, like "4 min 20 s".
#: assets/build/admin.js:7
msgid "Running for %s"
msgstr "En curso desde hace %s"

#: assets/build/admin.js:7
msgid "Nothing is checked while the scan is paused. Resume it to continue where it stopped."
msgstr "No se revisa nada mientras el escaneo está en pausa. Reanúdalo para continuar donde se quedó."

#: assets/build/admin.js:7
msgid "SeekFix reads your posts and pages, then checks every link, button and image in them. Broken links are listed in the Links tab, where you can fix them without opening each post."
msgstr "SeekFix lee tus entradas y páginas y luego revisa cada enlace, botón e imagen que contienen. Los enlaces rotos aparecen en la pestaña Enlaces, donde puedes corregirlos sin abrir cada entrada."

#: assets/build/admin.js:7
msgid "No scan yet. Start one to find the broken links in your posts and pages. It runs on your server and sends nothing to any external service."
msgstr "Todavía no hay escaneos. Inicia uno para encontrar los enlaces rotos de tus entradas y páginas. Se hace en tu servidor y no envía nada a ningún servicio externo."

#: assets/build/admin.js:7
msgid "Not found or gone, confirmed by a second check."
msgstr "No encontrados o eliminados, confirmado con una segunda revisión."

#: assets/build/admin.js:7
msgid "The site blocked the check or did not answer. Open them to check by hand."
msgstr "El sitio bloqueó la revisión o no respondió. Ábrelos para revisarlos a mano."

#: assets/build/admin.js:7
msgid "Redirects"
msgstr "Redirecciones"

#: assets/build/admin.js:7
msgid "They work, but go through another address first."
msgstr "Funcionan, pero pasan antes por otra dirección."

#: assets/build/admin.js:7
msgid "Checked"
msgstr "Revisadas"

#: assets/build/admin.js:7
msgid "Different URLs checked so far."
msgstr "URL distintas revisadas hasta ahora."

#: assets/build/admin.js:7
msgid "Waiting to be checked"
msgstr "Por revisar"

#: assets/build/admin.js:7
msgid "Found in your content, not checked yet."
msgstr "Encontradas en tu contenido, todavía sin revisar."

#: assets/build/admin.js:7
msgid "Start scan"
msgstr "Iniciar escaneo"

#: assets/build/admin.js:7
msgid "Scan again"
msgstr "Escanear de nuevo"

#: assets/build/admin.js:7
msgid "Pause"
msgstr "Pausar"

#: assets/build/admin.js:7
msgid "Resume"
msgstr "Reanudar"

#: assets/build/admin.js:7
#: assets/build/admin.js:15
#: assets/build/admin.js:27
msgid "Cancel"
msgstr "Cancelar"

#. translators: %s: date and time.
#: assets/build/admin.js:8
msgid "Last scan finished: %s"
msgstr "Último escaneo terminado: %s"

#. translators: %s: date and time.
#: assets/build/admin.js:9
msgid "Next automatic scan: %s"
msgstr "Próximo escaneo automático: %s"

#: assets/build/admin.js:9
msgid "Keep this screen open until the scan finishes. Links that fail once are checked again before they are marked broken."
msgstr "Deja esta pantalla abierta hasta que termine el escaneo. Los enlaces que fallan una vez se vuelven a revisar antes de marcarlos como rotos."

#: assets/build/admin.js:9
msgid "You can leave this screen: the scan continues in the background, more slowly. Links that fail once are checked again before they are marked broken."
msgstr "Puedes salir de esta pantalla: el escaneo sigue en segundo plano, más despacio. Los enlaces que fallan una vez se vuelven a revisar antes de marcarlos como rotos."

#. translators: %s: column name.
#: assets/build/admin.js:10
msgid "Resize the %s column"
msgstr "Cambiar el ancho de la columna %s"

#: assets/build/admin.js:10
msgid "Drag to resize. Double-click to reset."
msgstr "Arrastra para cambiar el ancho. Haz doble clic para restablecerlo."

#: assets/build/admin.js:10
msgid "Remove link"
msgstr "Quitar enlace"

#: assets/build/admin.js:10
msgid "Remove button"
msgstr "Quitar botón"

#: assets/build/admin.js:10
msgid "Replace URL"
msgstr "Reemplazar URL"

#: assets/build/admin.js:10
msgid "Update to final URL"
msgstr "Actualizar a la URL final"

#: assets/build/admin.js:10
msgid "The link is removed and its text stays in place."
msgstr "Se quita el enlace y su texto se queda en su lugar."

#: assets/build/admin.js:10
msgid "The button block is removed. If it was the only button in its group, the group goes too."
msgstr "Se quita el bloque de botón. Si era el único botón de su grupo, también se quita el grupo."

#: assets/build/admin.js:10
msgid "Only the link address changes."
msgstr "Solo cambia la dirección del enlace."

#: assets/build/admin.js:10
msgid "The link points straight to where the redirects end."
msgstr "El enlace apunta directo a donde terminan las redirecciones."

#: assets/build/admin.js:10
msgid "New URL"
msgstr "URL nueva"

#: assets/build/admin.js:10
msgid "The new URL is checked in the next scan."
msgstr "La URL nueva se revisa en el próximo escaneo."

#: assets/build/admin.js:10
msgid "Nothing to change: these links cannot be fixed from here."
msgstr "No hay nada que cambiar: estos enlaces no se pueden corregir desde aquí."

#. translators: %s: "N links in M posts".
#: assets/build/admin.js:11
msgid "This changes %s."
msgstr "Esto cambia %s."

