#. translators: 1: HTTP code, 2: its meaning, like "Not found".
#: assets/build/admin.js:16
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#. translators: %s: answer, like "404" or "Timed out".
#: assets/build/admin.js:17
msgid "Last answer from the server: %s."
msgstr "Última respuesta del servidor: %s."

#. translators: 1: redirect code, like "301", 2: final answer.
#: assets/build/admin.js:18
msgid "The link answers %1$s and sends visitors to another address, which answers %2$s."
msgstr "El enlace responde %1$s y manda a los visitantes a otra dirección, que responde %2$s."

#. translators: 1: number of redirects, 2: redirect codes, like "301, 302", 3: final answer.
#: assets/build/admin.js:19
msgid "The link sends visitors through %1$d other addresses (%2$s). The last one answers %3$s."
msgstr "El enlace manda a los visitantes por %1$d direcciones más (%2$s). La última responde %3$s."

#: assets/build/admin.js:19
msgid "Invalid certificate"
msgstr "Certificado no válido"

#: assets/build/admin.js:19
msgid "Broken:"
msgstr "Roto:"

#: assets/build/admin.js:19
msgid "the page is missing, confirmed by a second check."
msgstr "la página no existe, confirmado con una segunda revisión."

#: assets/build/admin.js:19
msgid "Cannot verify:"
msgstr "No se puede verificar:"

#: assets/build/admin.js:19
msgid "the site blocked the check or did not answer. Open the link to check it by hand."
msgstr "el sitio bloqueó la revisión o no respondió. Abre el enlace para revisarlo a mano."

#: assets/build/admin.js:19
msgid "Redirect:"
msgstr "Redirección:"

#: assets/build/admin.js:19
msgid "the link works, but goes through another address first."
msgstr "el enlace funciona, pero pasa antes por otra dirección."

#: assets/build/admin.js:19
#: assets/build/admin.js:25
msgid "Status"
msgstr "Estado"

#: assets/build/admin.js:19
msgid "Result of the last check of each link."
msgstr "Resultado de la última revisión de cada enlace."

#: assets/build/admin.js:19
msgid "Below, the server answers in order: 301 → 200 means the link was redirected, then the page loaded."
msgstr "Abajo, las respuestas del servidor en orden: 301 → 200 significa que el enlace se redirigió y luego cargó la página."

#: assets/build/admin.js:19
msgid "You can also undo it later from the History tab."
msgstr "También puedes deshacerlo después desde la pestaña Historial."

#: assets/build/admin.js:19
#: assets/build/admin.js:26
